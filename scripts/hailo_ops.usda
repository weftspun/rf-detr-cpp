                custom token[] sequence = ["Reshape", "OneHot", "Transpose", "MatMul", "Add"]
            }

            def Scope "TfIdfVectorizer"
            {
                custom string identity = "n-gram counting over TOKEN IDS, not text: the schema accepts tensor(int32) and tensor(int64) as well as tensor(string), so with ids in it is onehot-and-accumulate. It was refused as 'operates on strings' until the schema was actually read"
                custom token[] sequence = ["OneHot", "MatMul", "ReduceSum"]
            }

            def Scope "TopK"
            {
                custom string identity = "a bitonic sorting network of Min and Max, then Slice. The depth is O(log^2 n) and fixed, so it is a static graph; topk_bitonic.py is the working"
                custom token[] sequence = ["Min", "Max", "Concat", "Slice"]
            }

        }

