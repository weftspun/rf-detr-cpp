        def Scope "StringNormalizer"
        {
            custom token category = "not-reproducible"
            custom string reason = "case folding here is LOCALE-DEPENDENT: the schema's locale attribute is 'environment dependent', so the same graph gives different output on different machines. That is the objection Blender is blocklisted for and it is fatal on its own. Unicode folding is also not length-preserving -- sharp s folds to ss, the Turkish dotted and dotless i disagree -- so no fixed-shape tensor operation expresses it, and folding a string as bytes is ASCII thinking. Tokenize before the graph"
        }

        def Scope "Unique"
        {
            custom token category = "data-dependent-shape"
            custom string reason = "the output length is the number of distinct values"
        }

