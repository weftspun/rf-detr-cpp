        def Scope "TrigonometricApproximate"
        {
            custom string warning = "APPROXIMATE, and RANGE LIMITED. These are polynomials, not identities, so they are absent from RfdetrProofs/Secondary.lean on purpose -- a theorem claiming equality would be false. Worse, they hold only on [-pi/2, pi/2]. Reviewed against tinygrad codegen/decomp/transcendental.py (MIT), itself derived from SLEEF: the POLYNOMIAL is plain multiply-add and emits fine, but the Payne-Hanek and Cody-Waite range reductions that make it valid everywhere rest on bitcast, shifts, frexp, ldexp and round-to-int -- 31 casts and 6 bitcasts in that file -- and every one of those is in Refused. So a correct sine over the reals is not reachable on this target, and an argument outside the interval returns a wrong number rather than an error."
            def Scope "Acos"
            {
                custom string identity = "acos(x) == pi/2 - asin(x)"
                custom token[] sequence = ["Sub", "Mul", "Add", "Sqrt"]
                custom token proof = "approximate"
            }

            def Scope "Asin"
            {
                custom string identity = "asin(x) == x * P(x^2) on the principal branch"
                custom token[] sequence = ["Mul", "Add", "Sqrt"]
                custom token proof = "approximate"
            }

            def Scope "Atan"
            {
                custom string identity = "atan(x) == x * P(x^2) after quadrant folding"
                custom token[] sequence = ["Mul", "Add", "Div"]
                custom token proof = "approximate"
            }

            def Scope "Cos"
            {
                custom string identity = "cos(x) == sin(x + pi/2), same polynomial. VALID ONLY ON [-pi/2, pi/2]"
                custom token[] sequence = ["Mul", "Add"]
                custom token proof = "approximate"
            }

            def Scope "Sin"
            {
                custom string identity = "sin(x) == x * P(x^2), a degree-9 odd polynomial. VALID ONLY ON [-pi/2, pi/2] here -- see the category warning"
                custom token[] sequence = ["Mul", "Add"]
                custom token proof = "approximate"
            }

            def Scope "Tan"
            {
                custom string identity = "tan(x) == sin(x) / cos(x); range limited AND unbounded near pi/2"
                custom token[] sequence = ["Mul", "Add", "Div"]
                custom token proof = "approximate"
            }

        }

    }

    def Scope "Refused"
    {
        custom string note = "No rewrite, and the category says how permanent that is. A data-dependent shape can never be a static graph; a rounding refusal is a measurement that could be revisited on a wider datapath."

        def Scope "Bernoulli"
        {
            custom token category = "nondeterministic"
            custom string reason = "sampling; no deterministic rewrite"
        }

        def Scope "BitShift"
        {
            custom token category = "rounding"
            custom string reason = "integer bit manipulation on a float datapath"
        }

        def Scope "Cast"
        {
            custom token category = "rounding"
            custom string reason = "a relabelling cast is removed; a value-changing one is refused. The target ACCEPTS one and does not perform it, returning an f32 -> s32 -> f32 round trip untruncated and wrong by 0.875"
        }

        def Scope "Ceil"
        {
            custom token category = "rounding"
            custom string reason = "as Floor"
        }

