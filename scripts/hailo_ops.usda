            def Scope "LpPool"
            {
                custom string identity = "windowed Lp pool == (avgpool(|x|^p) * window)^(1/p)"
                custom token[] sequence = ["Abs", "Pow", "AveragePool"]
            }

            def Scope "MeanVarianceNormalization"
            {
                custom string identity = "(x - mean) / sqrt(var + eps), which is layer norm without the learned scale and shift"
                custom token[] sequence = ["LayerNormalization"]
                custom token spec_body = "usable"
                custom string source = "ONNX spec FunctionProto, Apache-2.0 -- authoritative, and it disagrees with the hand-written identity in at least one place: the spec builds GreaterOrEqual from Equal, Greater and Or where this table had 1 - Less. Both compute it; only one is the specification."
            }

