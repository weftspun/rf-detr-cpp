#usda 1.0
(
    doc = """ONNX operator names the accelerator toolchain documents as supported.

    Operator names only. These are ONNX identifiers -- facts about an interface -- read out of
    the vendor's supported-layer and supported-activation tables.

    ESSENTIAL TUPLE NORMAL FORM. `Layers` and `Activations` are satellite relations rather than
    one relation with a nullable kind column, because an operator is not a layer-with-a-null.
    Nothing derivable is stored: the union of the two, which is what a caller usually wants, is
    computed rather than written down, so the two cannot disagree with a third copy.

    PATTERNS ARE A SEPARATE RELATION for the same reason. Some activations are reachable only
    as a fixed sequence of operators and never as a bare one, so membership in a sequence is a
    different fact from membership in a list, and it gets its own place rather than a flag.

    `Erf` is why this file carries patterns at all: it appears in neither list alone, and is
    accepted only inside the gelu sequence. A real 825-node export contains twelve `Erf` nodes
    and compiles; a standalone `Erf` is rejected at parse.
    """
    subLayers = []
)

def Scope "HailoOps"
{
    custom string source = "Dataflow Compiler 5.3.0, supported-layer and supported-activation tables"
    custom int opset = 17

    def Scope "Layers"
    {
        custom token[] ops = [
            "Add", "ArgMax", "AveragePool", "BatchNormalization", "Concat", "Conv",
            "ConvTranspose", "DepthToSpace", "Div", "Dropout", "GRU", "Gemm", "LSTM",
            "LayerNormalization", "LogSoftmax", "MatMul", "Max", "MaxPool", "Min", "Mul",
            "Neg", "OneHot", "Pad", "Pow", "RNN", "ReduceL2", "ReduceMax", "ReduceMean",
            "ReduceMin", "ReduceSum", "ReduceSumSquare", "Reshape", "Resize", "Slice",
            "Softmax", "SpaceToDepth", "Split", "Sub", "Transpose", "Upsample"
        ]
    }

    def Scope "Activations"
    {
        custom token[] ops = [
            "Abs", "Clip", "Elu", "Equal", "Exp", "Greater", "HardSigmoid", "LeakyRelu",
            "Less", "Log", "Min", "PRelu", "Relu", "Sigmoid", "Softplus", "Softsign",
            "Sqrt", "Tanh"
        ]
    }

    def Scope "Patterns"
    {
        def Scope "Gelu"
        {
            custom token[] sequence = ["Mul", "Erf"]
        }
        def Scope "HardSwish"
        {
            custom token[] sequence = ["Mul", "HardSigmoid"]
        }
        def Scope "Silu"
        {
            custom token[] sequence = ["Mul", "Sigmoid"]
        }
        def Scope "Mish"
        {
            custom token[] sequence = ["Mul", "Tanh", "Softplus"]
        }
    }

    def Scope "OnnxSpec"
    {
        custom string producer = "onnx 1.22.0, ai.onnx domain, schemas with history"
        custom int opset = 17

        custom token[] ops = [
            "Abs", "Acos", "Acosh", "Add", "And", "ArgMax", "ArgMin", "Asin", "Asinh", "Atan",
            "Atanh", "AveragePool", "BatchNormalization", "Bernoulli", "BitShift",
            "BlackmanWindow", "Cast", "CastLike", "Ceil", "Celu", "Clip", "Compress", "Concat",
            "ConcatFromSequence", "Constant", "ConstantOfShape", "Conv", "ConvInteger",
            "ConvTranspose", "Cos", "Cosh", "CumSum", "DFT", "DepthToSpace", "DequantizeLinear",
            "Det", "Div", "Dropout", "DynamicQuantizeLinear", "Einsum", "Elu", "Equal", "Erf",
            "Exp", "Expand", "EyeLike", "Flatten", "Floor", "GRU", "Gather", "GatherElements",
            "GatherND", "Gemm", "GlobalAveragePool", "GlobalLpPool", "GlobalMaxPool", "Greater",
            "GreaterOrEqual", "GridSample", "HammingWindow", "HannWindow", "HardSigmoid",
            "HardSwish", "Hardmax", "Identity", "If", "InstanceNormalization", "IsInf", "IsNaN",
            "LRN", "LSTM", "LayerNormalization", "LeakyRelu", "Less", "LessOrEqual", "Log",
            "LogSoftmax", "Loop", "LpNormalization", "LpPool", "MatMul", "MatMulInteger", "Max",
            "MaxPool", "MaxRoiPool", "MaxUnpool", "Mean", "MeanVarianceNormalization",
            "MelWeightMatrix", "Min", "Mod", "Mul", "Multinomial", "Neg",
            "NegativeLogLikelihoodLoss", "NonMaxSuppression", "NonZero", "Not", "OneHot",
            "Optional", "OptionalGetElement", "OptionalHasElement", "Or", "PRelu", "Pad", "Pow",
            "QLinearConv", "QLinearMatMul", "QuantizeLinear", "RNN", "RandomNormal",
            "RandomNormalLike", "RandomUniform", "RandomUniformLike", "Range", "Reciprocal",
            "ReduceL1", "ReduceL2", "ReduceLogSum", "ReduceLogSumExp", "ReduceMax", "ReduceMean",
            "ReduceMin", "ReduceProd", "ReduceSum", "ReduceSumSquare", "Relu", "Reshape",
            "Resize", "ReverseSequence", "RoiAlign", "Round", "STFT", "Scan", "Scatter",
            "ScatterElements", "ScatterND", "Selu", "SequenceAt", "SequenceConstruct",
            "SequenceEmpty", "SequenceErase", "SequenceInsert", "SequenceLength", "SequenceMap",
            "Shape", "Shrink", "Sigmoid", "Sign", "Sin", "Sinh", "Size", "Slice", "Softmax",
            "SoftmaxCrossEntropyLoss", "Softplus", "Softsign", "SpaceToDepth", "Split",
            "SplitToSequence", "Sqrt", "Squeeze", "StringNormalizer", "Sub", "Sum", "Tan", "Tanh",
            "TfIdfVectorizer", "ThresholdedRelu", "Tile", "TopK", "Transpose", "Trilu", "Unique",
            "Unsqueeze", "Upsample", "Where", "Xor"
        ]
    }

    def Scope "Secondary"
    {
        custom string note = "Every opset-17 operator the target does not implement, with either a rewrite into ones it does or a reason there is none. Both are entries: an operator with no row would be indistinguishable from one nobody has examined."

        def Scope "Activation"
        {
            def Scope "Celu"
            {
                custom string identity = "celu(x) == max(0, x) + min(0, a * (exp(x / a) - 1))"
                custom token[] sequence = ["Relu", "Div", "Exp", "Sub", "Mul", "Min", "Add"]
                custom token proof = "analysis"
            }

            def Scope "HardSwish"
            {
                custom string identity = "hardswish(x) == x * hardsigmoid(x); the target names this pattern"
                custom token[] sequence = ["Mul", "HardSigmoid"]
                custom token spec_body = "usable"
                custom string source = "ONNX spec FunctionProto, Apache-2.0 -- authoritative, and it disagrees with the hand-written identity in at least one place: the spec builds GreaterOrEqual from Equal, Greater and Or where this table had 1 - Less. Both compute it; only one is the specification."
            }

            def Scope "Hardmax"
            {
                custom string identity = "hardmax(x) == onehot(argmax(x)); the target implements OneHot natively, which is what makes this cheap rather than a tent reconstruction"
                custom token[] sequence = ["ArgMax", "OneHot"]
            }

            def Scope "Selu"
            {
                custom string identity = "selu(x) == g * (max(0, x) + min(0, a * (exp(x) - 1)))"
                custom token[] sequence = ["Relu", "Exp", "Sub", "Mul", "Min", "Add"]
                custom token proof = "analysis"
                custom token spec_body = "usable"
                custom string source = "ONNX spec FunctionProto, Apache-2.0 -- authoritative, and it disagrees with the hand-written identity in at least one place: the spec builds GreaterOrEqual from Equal, Greater and Or where this table had 1 - Less. Both compute it; only one is the specification."
            }

            def Scope "Shrink"
            {
                custom string identity = "shrink(x) == (x < -l)(x + b) + (x > l)(x - b)"
                custom token[] sequence = ["Less", "Greater", "Add", "Sub", "Mul"]
                custom token spec_body = "usable"
                custom string source = "ONNX spec FunctionProto, Apache-2.0 -- authoritative, and it disagrees with the hand-written identity in at least one place: the spec builds GreaterOrEqual from Equal, Greater and Or where this table had 1 - Less. Both compute it; only one is the specification."
            }

            def Scope "Softsign"
            {
                custom string identity = "x / (1 + |x|)"
                custom token[] sequence = ["Abs", "Add", "Div"]
                custom token proof = "analysis"
            }

            def Scope "ThresholdedRelu"
            {
                custom string identity = "thresholded relu(x) == x * (x > theta)"
                custom token[] sequence = ["Greater", "Mul"]
                custom token proof = "analysis"
                custom token spec_body = "usable"
                custom string source = "ONNX spec FunctionProto, Apache-2.0 -- authoritative, and it disagrees with the hand-written identity in at least one place: the spec builds GreaterOrEqual from Equal, Greater and Or where this table had 1 - Less. Both compute it; only one is the specification."
            }

        }

        def Scope "Boolean"
        {
            def Scope "And"
            {
                custom string identity = "a and b == a * b, on {0, 1}"
                custom token[] sequence = ["Mul"]
                custom token proof = "ring"
            }

            def Scope "Not"
            {
                custom string identity = "not a == 1 - a, on {0, 1}"
                custom token[] sequence = ["Sub"]
                custom token proof = "ring"
            }

            def Scope "Or"
            {
                custom string identity = "a or b == a + b - a * b, on {0, 1}"
                custom token[] sequence = ["Add", "Sub", "Mul"]
                custom token proof = "ring"
            }

            def Scope "Xor"
            {
                custom string identity = "a xor b == a + b - 2 * a * b, on {0, 1}"
                custom token[] sequence = ["Add", "Sub", "Mul"]
                custom token proof = "ring"
            }

        }

        def Scope "HyperbolicExact"
        {
            def Scope "Acosh"
            {
                custom string identity = "acosh(x) == log(x + sqrt(x^2 - 1)), exact for x >= 1"
                custom token[] sequence = ["Mul", "Sub", "Sqrt", "Log"]
                custom token proof = "analysis"
            }

            def Scope "Asinh"
            {
                custom string identity = "asinh(x) == log(x + sqrt(x^2 + 1)), exact"
                custom token[] sequence = ["Mul", "Add", "Sqrt", "Log"]
                custom token proof = "analysis"
            }

            def Scope "Atanh"
            {
                custom string identity = "atanh(x) == 0.5 * log((1 + x) / (1 - x)), exact for |x| < 1"
                custom token[] sequence = ["Add", "Sub", "Div", "Log", "Mul"]
                custom token proof = "analysis"
            }

            def Scope "Cosh"
            {
                custom string identity = "cosh(x) == (exp(x) + exp(-x)) / 2, exact"
                custom token[] sequence = ["Exp", "Neg", "Add", "Div"]
                custom token proof = "analysis"
            }

            def Scope "Sinh"
            {
                custom string identity = "sinh(x) == (exp(x) - exp(-x)) / 2, exact"
                custom token[] sequence = ["Exp", "Neg", "Sub", "Div"]
                custom token proof = "analysis"
            }

        }

        def Scope "Indexing"
        {
            def Scope "Gather"
            {
                custom string identity = "gather(data, idx) == onehot(idx) @ data. The accelerator implements OneHot as a convolution with a delta activation, so the index is never quantised -- which is the whole reason to prefer it to a tent kernel"
                custom token[] sequence = ["OneHot", "MatMul"]
            }

            def Scope "GatherElements"
